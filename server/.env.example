# HHTTPS Server — Environment Configuration (v0.4.1 + phase 8 email-anchored identity)
#
# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore).

# ─── Application ─────────────────────────────────────────────────────────
PORT=3000
RP_ID=hhttps.org
ORIGIN=https://hhttps.org
BASE_URL=https://hhttps.org
# Set NODE_ENV=production on every real deployment. In production the server
# refuses to boot without HHTTPS_VERIFICATION_PEPPER and EMAIL_DEV_MODE has
# no effect (see below).
NODE_ENV=production

# ─── Identity anchor pepper (REQUIRED in production) ─────────────────────
# Server-side HMAC key for the identity anchors:
#   - E-mail anchor:  HMAC-SHA256(pepper, trim+lower(email)) → stable userId
#                     (phase 8, table identity_anchors)
#   - GitHub anchor:  peppered SHA-256 of the GitHub account id (external-verify.js)
# The pepper IS the identity: the same e-mail resolves to the same userId (and
# therefore to the same pairwise `sub` on every platform) only while the
# pepper stays the same. NEVER rotate it without re-computing every
# identity_anchors.email_hash — otherwise every user silently loses their
# stable identity, pseudonym and passkey binding on the next login.
# Generate once, back it up with the DB:  openssl rand -hex 32
# Without it: dev fallback 'dev-pepper' (with a warning); in production the
# server exits at boot.
HHTTPS_VERIFICATION_PEPPER=

# ─── Pairwise subject secret (REQUIRED in production) ────────────────────
# HMAC key behind the pairwise `sub` an OAuth platform sees:
#   sub = HMAC-SHA256(PAIRWISE_SECRET, userId + '|' + client_id)
# Same role as the pepper above: the value IS the identity a platform knows.
# Rotating it changes every pairwise `sub`, so every user looks like a NEW
# account to every connected platform. Generate once, back it up with the DB:
#   openssl rand -hex 32
# Without it: deterministic public fallback in dev (with a warning); in
# production the server exits at boot (Review 2026-09, AP2-15).
PAIRWISE_SECRET=

# ─── EUDI PID issuer trust (recommended before go-live) ──────────────────
# EUDIPLO validates the PID issuer chain ONLY when the DCQL query carries
# `trusted_authorities`. Set this to the EUDIPLO-hosted PID trust list once
# the LoTE is installed; `off` skips the binding deliberately. Unset → PID
# presentations (age via PID, eID) are accepted from ANY issuer and the
# server logs a warning at boot (Review 2026-09, AP4-18).
# EUDI_PID_TRUST_LIST=<TENANT_URL>/trust-list/pid-trusted-list

# ─── PostgreSQL ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hhttps
DB_USER=hhttps
DB_PASSWORD=                # set this — install-pg.sh generates one

# ─── SMTP (for email verification) ───────────────────────────────────────
# Optional but recommended. Without these, email-verified methods won't work.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=HHTTPS Issuer
# SMTP_REPLY_TO=info@example.com   # optional, if SMTP_FROM is not receivable

# E-mail dev mode — DEVELOPMENT ONLY. With EMAIL_DEV_MODE=1 and no usable
# transport (no SMTP, no /usr/sbin/sendmail) the server does not send a mail
# but returns the 6-digit code / magic link in the /hhttps/email/send API
# response (devCode, devToken, devVerifyUrl). Anyone who can call the API
# then owns the address. Ignored when NODE_ENV=production; without it a
# missing transport answers 503 email_transport_unavailable (fail closed).
# EMAIL_DEV_MODE=1

# ─── External verification providers ─────────────────────────────────────
# GitHub OAuth app for the `developer` role (/hhttps/verify/github/start).
# Leave empty to disable GitHub verification.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret between server.js and the EUDI verifier (server/eudi-verifier)
# that signs age / (Q)EAA presentation results for /hhttps/eid/upgrade and
# /hhttps/age/*. Required for EUDI-based verification; openssl rand -hex 32.
EUDI_VERIFIER_SECRET=

# ─── Admin notifications ─────────────────────────────────────────────────
# Operator inbox. Receives a mail when a platform is registered (FYI) and
# when one is submitted for review (action required). Comma-separated list
# allowed. Leave unset to disable admin notifications entirely.
ADMIN_NOTIFY_EMAIL=

# ─── Token TTLs (seconds, optional — defaults below) ─────────────────────
# ACCESS_TTL=3600           # 1 hour
# REFRESH_TTL=604800        # 7 days

# ─── Rate limits (optional — defaults are sensible) ──────────────────────
# RATE_LIMIT_GLOBAL=300     # requests per minute per IP
# RATE_LIMIT_WEBAUTHN=20    # per 15 minutes
# RATE_LIMIT_EMAIL=5        # per hour
