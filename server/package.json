{
  "name": "hhttps-role-api",
  "version": "4.1.0",
  "description": "HHTTPS — Role Identity API: pseudonymous role identity (passkey, e-mail anchor, EUDI) with an OAuth 2.0 / OIDC provider, on PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dry-run": "node scripts/migrate.js --dry-run",
    "test": "node --test \"test/unit/**/*.test.mjs\" \"test/integration/**/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/**/*.e2e.test.mjs\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@simplewebauthn/server": "^9.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@simplewebauthn/browser": "^9.0.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.56.1"
  }
}
